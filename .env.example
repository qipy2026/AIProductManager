# 智服通 AgentOps 环境变量示例
# 复制为 .env 或在启动前 export / $env: 设置

# === 运营数据持久化（Skill 健康度 / Bad Case / Trace）===
# sqlite = 本地 data/agentops.db
# mysql  = WSL MySQL（见 docs/WSL-MYSQL-SETUP.md）
OPS_DB=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=agentops
MYSQL_PASSWORD=Agentops@2026!
MYSQL_DATABASE=agentops

# === 全量业务存储（可选，评测默认 memory 不影响）===
# AGENTOPS_STORAGE=memory
# AGENTOPS_STORAGE=mysql

# 前端代理后端（默认 8002，与 start_backend_mysql.ps1 一致）
BACKEND_URL=http://localhost:8002

# === 大模型（OpenAI 兼容接口）===
# LLM_MODE=openai
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=minimax-m2.1:cloud
